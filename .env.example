# Pipeline secrets. Copy to .env for local runs; on GitHub these are repository
# secrets (Settings -> Secrets and variables -> Actions). Never commit .env.

# Service account JSON for the Firebase project, on a single line.
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
FIREBASE_SERVICE_ACCOUNT=

# Google AI Studio key for Gemini. Free tier: do NOT enable billing on the
# linked Google Cloud project or the free tier disappears.
GEMINI_API_KEY=

# Web Push (VAPID). Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
