# MODELLO. Questo file non contiene segreti e finisce nel repository.
# I segreti veri vanno in `.env`, che si chiama senza `.example` ed e' ignorato
# da git. Se stai per incollare una chiave qui dentro, hai aperto il file
# sbagliato: copia questo in `.env` e incollala li'.
#
# Su GitHub gli stessi nomi diventano repository secrets, sotto
# Settings -> Secrets and variables -> Actions.
#
# Niente di quello che sta qui coincide con i valori in
# app/src/app/core/firebase.config.ts: quelli sono pubblici e vivono nel
# browser. Questi no.

# ---------------------------------------------------------------------------
# Gemini, da Google AI Studio -> Get API key. Una riga, comincia con AIza.
# Piano gratuito: non attivare MAI la fatturazione sul progetto Google
# collegato, altrimenti il piano gratuito sparisce.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Service account Firebase: accesso completo e senza limiti al database. Le
# regole di firestore.rules non valgono per chi ce l'ha.
#
# Console Firebase -> ingranaggio -> Project settings -> scheda Service
# accounts -> Generate new private key. Scarica un file .json.
#
# Apri quel file, copialo TUTTO e incollalo in `.env` tra apici singoli. Le
# sequenze \n dentro private_key vanno lasciate come sono: fanno parte della
# chiave, non sono a capo da espandere.
#
# Viene una riga cosi', solo molto piu' lunga:
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...",...}'
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT=

# ---------------------------------------------------------------------------
# Web Push, servono dalla Fase 5. Fino ad allora lasciale vuote.
# Generale una volta sola con: npx web-push generate-vapid-keys
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
